{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melo-game-creative-studio.dev/schemas/headless/asset-manifest.schema.json",
  "title": "Melo Asset Manifest v1",
  "type": "object",
  "required": [
    "contract",
    "contractVersion",
    "id",
    "version",
    "kind",
    "origin",
    "runtime"
  ],
  "properties": {
    "contract": {
      "const": "melo.asset-manifest"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "bitmap",
        "vector",
        "font",
        "audio",
        "texture-set",
        "geometry-3d",
        "animation-asset",
        "material-pack",
        "effect-pack",
        "look-pack",
        "plugin-package",
        "camera-profile",
        "board-skin",
        "tile-face",
        "background",
        "ui-theme"
      ]
    },
    "origin": {
      "enum": [
        "builtin",
        "uploaded",
        "generated",
        "project",
        "external-dcc"
      ]
    },
    "contentHash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-fA-F]{64}|fnv1a32:[0-9a-fA-F]{8})$"
    },
    "runtime": {
      "type": "object",
      "required": [
        "renderers",
        "deterministic"
      ],
      "properties": {
        "renderers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reference-2d",
              "fixed-camera-cinematic",
              "three-3d"
            ]
          }
        },
        "deterministic": {
          "type": "boolean"
        },
        "budget": {
          "type": "object",
          "properties": {
            "textureMemoryMiB": {
              "type": "number",
              "minimum": 0
            },
            "triangleCount": {
              "type": "number",
              "minimum": 0
            },
            "pluginMemoryMiB": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object"
    },
    "behavior": {
      "type": "object"
    },
    "supportedEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibleMaterialClasses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/assetRef"
      }
    },
    "apiVersion": {
      "type": "string"
    },
    "executionRuntime": {
      "enum": [
        "web-worker",
        "node-worker",
        "wasm"
      ]
    },
    "entry": {
      "type": "string"
    },
    "inputSchemaRef": {
      "type": "string"
    },
    "outputSchemaRef": {
      "type": "string"
    },
    "timeoutMs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "network",
          "filesystem-read",
          "filesystem-write",
          "process-spawn",
          "dom"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRef"
      }
    }
  },
  "$defs": {
    "assetRef": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
