{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melo-creative.local/schema/game-render-contract.json",
  "title": "Game render contract",
  "type": "object",
  "required": ["contract", "contractVersion", "id", "version", "gameId", "eventCatalog", "backends"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "melo.game-render-contract" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "eventCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "category", "tags"],
        "properties": {
          "type": { "type": "string" },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "backends": { "type": "object" }
  }
}
