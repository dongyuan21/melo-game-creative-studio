{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melo-creative.local/schema/fixed-camera-profile-v1.json",
  "title": "Fixed-camera cinematic profile",
  "type": "object",
  "required": [
    "id",
    "designResolution",
    "boardScreenRect",
    "pose",
    "projection",
    "motionPolicy"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "designResolution": { "$ref": "#/$defs/resolution" },
    "boardScreenRect": { "$ref": "#/$defs/rect" },
    "pose": {
      "type": "object",
      "required": ["position", "rotationEulerRadians"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotationEulerRadians": { "$ref": "#/$defs/vec3" }
      },
      "additionalProperties": false
    },
    "projection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": { "mode": { "const": "calibration-pending" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "focalLengthMm", "sensorWidthMm", "near", "far"],
          "properties": {
            "mode": { "const": "perspective" },
            "focalLengthMm": { "type": "number", "exclusiveMinimum": 0 },
            "sensorWidthMm": { "type": "number", "exclusiveMinimum": 0 },
            "near": { "type": "number", "exclusiveMinimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "verticalWorldSize", "near", "far"],
          "properties": {
            "mode": { "const": "orthographic" },
            "verticalWorldSize": { "type": "number", "exclusiveMinimum": 0 },
            "near": { "type": "number", "exclusiveMinimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "motionPolicy": {
      "type": "object",
      "required": [
        "transformAnimation",
        "orbit",
        "lensAnimation",
        "screenShake",
        "screenTranslate",
        "screenZoom",
        "maximumScreenZoom",
        "maximumScreenRotationDegrees"
      ],
      "properties": {
        "transformAnimation": { "const": false },
        "orbit": { "const": false },
        "lensAnimation": { "const": false },
        "screenShake": { "type": "boolean" },
        "screenTranslate": { "type": "boolean" },
        "screenZoom": { "type": "boolean" },
        "maximumScreenZoom": { "type": "number", "minimum": 1, "maximum": 1.1 },
        "maximumScreenRotationDegrees": { "type": "number", "minimum": 0, "maximum": 3 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
